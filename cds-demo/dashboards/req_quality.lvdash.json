{
  "datasets": [
    {
      "name": "row_status",
      "displayName": "Row status by table",
      "queryLines": [
        "WITH checked_rows AS (\n",
        "  SELECT 'continuation_transformation' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS table_name, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `nom_entreprise`\n",
        ")\n",
        "SELECT table_name,\n",
        "  CASE WHEN coalesce(size(errors), 0) > 0 THEN 'Error'\n",
        "    WHEN coalesce(size(warnings), 0) > 0 THEN 'Warning'\n",
        "    ELSE 'OK' END AS status,\n",
        "  count(*) AS row_count\n",
        "FROM checked_rows\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "occurrences_by_check",
      "displayName": "Occurrences by check",
      "queryLines": [
        "WITH checked_rows AS (\n",
        "  SELECT 'continuation_transformation' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS table_name, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `nom_entreprise`\n",
        "),\n",
        "occurrences AS (\n",
        "  SELECT table_name, row_key, 'Error' AS severity, result\n",
        "  FROM checked_rows LATERAL VIEW explode(errors) e AS result\n",
        "  UNION ALL\n",
        "  SELECT table_name, row_key, 'Warning' AS severity, result\n",
        "  FROM checked_rows LATERAL VIEW explode(warnings) w AS result\n",
        ")\n",
        "SELECT table_name, result.name AS check_name, severity, count(*) AS occurrences\n",
        "FROM occurrences\n",
        "GROUP BY table_name, result.name, severity"
      ]
    },
    {
      "name": "occurrences",
      "displayName": "Occurrences",
      "queryLines": [
        "WITH checked_rows AS (\n",
        "  SELECT 'continuation_transformation' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS table_name, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS table_name, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS row_key,\n",
        "    `_errors` AS errors,\n",
        "    `_warnings` AS warnings\n",
        "  FROM `nom_entreprise`\n",
        "),\n",
        "occurrences AS (\n",
        "  SELECT table_name, row_key, 'Error' AS severity, result\n",
        "  FROM checked_rows LATERAL VIEW explode(errors) e AS result\n",
        "  UNION ALL\n",
        "  SELECT table_name, row_key, 'Warning' AS severity, result\n",
        "  FROM checked_rows LATERAL VIEW explode(warnings) w AS result\n",
        ")\n",
        "SELECT table_name, row_key, severity,\n",
        "  result.name AS check_name,\n",
        "  result.function AS dqx_function,\n",
        "  array_join(result.columns, ', ') AS checked_columns,\n",
        "  result.message AS message,\n",
        "  date_format(result.run_time, 'yyyy-MM-dd HH:mm:ss') AS checked_at\n",
        "FROM occurrences"
      ]
    }
  ],
