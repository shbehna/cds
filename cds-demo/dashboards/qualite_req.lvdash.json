{
  "datasets": [
    {
      "name": "statut_lignes",
      "displayName": "Statut des lignes par table",
      "queryLines": [
        "WITH lignes AS (\n",
        "  SELECT 'continuation_transformation' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS nom_table, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `nom_entreprise`\n",
        ")\n",
        "SELECT nom_table,\n",
        "  CASE WHEN coalesce(size(erreurs), 0) > 0 THEN 'Erreur'\n",
        "    WHEN coalesce(size(avertissements), 0) > 0 THEN 'Avertissement'\n",
        "    ELSE 'OK' END AS statut,\n",
        "  count(*) AS lignes\n",
        "FROM lignes\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "occurrences_par_validation",
      "displayName": "Occurrences par validation",
      "queryLines": [
        "WITH lignes AS (\n",
        "  SELECT 'continuation_transformation' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS nom_table, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `nom_entreprise`\n",
        "),\n",
        "occurrences AS (\n",
        "  SELECT nom_table, cle, 'Erreur' AS severite, resultat\n",
        "  FROM lignes LATERAL VIEW explode(erreurs) e AS resultat\n",
        "  UNION ALL\n",
        "  SELECT nom_table, cle, 'Avertissement' AS severite, resultat\n",
        "  FROM lignes LATERAL VIEW explode(avertissements) a AS resultat\n",
        ")\n",
        "SELECT nom_table, resultat.name AS validation, severite, count(*) AS occurrences\n",
        "FROM occurrences\n",
        "GROUP BY nom_table, resultat.name, severite"
      ]
    },
    {
      "name": "occurrences",
      "displayName": "Occurrences",
      "queryLines": [
        "WITH lignes AS (\n",
        "  SELECT 'continuation_transformation' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'code_type_changement', `code_type_changement`, 'date_effet', `date_effet`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `continuation_transformation`\n",
        "  UNION ALL\n",
        "  SELECT 'domaine_valeur' AS nom_table, to_json(named_struct('domaine', `domaine`, 'code', `code`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `domaine_valeur`\n",
        "  UNION ALL\n",
        "  SELECT 'entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `entreprise`\n",
        "  UNION ALL\n",
        "  SELECT 'etablissement' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_etablissement', `numero_etablissement`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `etablissement`\n",
        "  UNION ALL\n",
        "  SELECT 'fusion_scission' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'numero_entreprise_liee', `numero_entreprise_liee`, 'nom_entreprise_liee', `nom_entreprise_liee`, 'code_relation', `code_relation`, 'date_effet', `date_effet`, 'indicateur_dispense_adresse', `indicateur_dispense_adresse`, 'adresse_ligne_1', `adresse_ligne_1`, 'adresse_ligne_2', `adresse_ligne_2`, 'adresse_ligne_3', `adresse_ligne_3`, 'adresse_ligne_4', `adresse_ligne_4`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `fusion_scission`\n",
        "  UNION ALL\n",
        "  SELECT 'nom_entreprise' AS nom_table, to_json(named_struct('numero_entreprise', `numero_entreprise`, 'nom', `nom`, 'code_type_nom', `code_type_nom`, 'date_inscription', `date_inscription`), map('ignoreNullFields', 'false')) AS cle,\n",
        "    `_errors` AS erreurs,\n",
        "    `_warnings` AS avertissements\n",
        "  FROM `nom_entreprise`\n",
        "),\n",
        "occurrences AS (\n",
        "  SELECT nom_table, cle, 'Erreur' AS severite, resultat\n",
        "  FROM lignes LATERAL VIEW explode(erreurs) e AS resultat\n",
        "  UNION ALL\n",
        "  SELECT nom_table, cle, 'Avertissement' AS severite, resultat\n",
        "  FROM lignes LATERAL VIEW explode(avertissements) a AS resultat\n",
        ")\n",
        "SELECT nom_table, cle, severite,\n",
        "  resultat.name AS validation,\n",
        "  resultat.function AS fonction,\n",
        "  array_join(resultat.columns, ', ') AS colonnes,\n",
        "  resultat.message AS message,\n",
        "  resultat.run_time AS date_verification\n",
        "FROM occurrences"
      ]
    }
